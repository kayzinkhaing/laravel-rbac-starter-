<?php

namespace App\Http\Controllers\Web;

use Illuminate\Routing\Controller;
use App\Models\Address;
use App\Models\Country;
use App\Models\District;
use App\Models\State;
use App\Models\Township;
use App\Models\Ward;
use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;
use Illuminate\Validation\ValidationException;
use Illuminate\View\View;

class AddressController extends Controller
{
    public function index(Request $request): View
    {
        return view('addresses.index', [
            'addresses' => $request->user()->addresses()
                ->with(['country', 'state', 'district', 'township', 'ward'])
                ->latest()
                ->paginate(10),
        ]);
    }

    public function create(): View
    {
        return view('addresses.create', [
            'countries' => Country::query()->orderBy('name')->get(),
            'locationOptions' => [
                'state_id' => collect(),
                'district_id' => collect(),
                'township_id' => collect(),
                'ward_id' => collect(),
            ],
            'address' => new Address(),
        ]);
    }

    public function store(Request $request): RedirectResponse
    {
        $data = $this->validatedData($request);

        DB::transaction(function () use ($request, &$data): void {
            if ($data['is_default'] ?? false) {
                $request->user()->addresses()->update(['is_default' => false]);
            }

            $request->user()->addresses()->create($data);
        });

        return redirect()->route('addresses.index')->with('success', 'Address saved.');
    }

    public function edit(Request $request, Address $address): View
    {
        $this->ensureOwner($request, $address);

        $address->load(['country', 'state', 'district', 'township', 'ward']);

        return view('addresses.edit', [
            'address' => $address,
            'countries' => Country::query()->orderBy('name')->get(),
            'locationOptions' => [
                'state_id' => $address->country?->states()->orderBy('name')->get() ?? collect(),
                'district_id' => $address->state?->districts()->orderBy('name')->get() ?? collect(),
                'township_id' => $address->district?->townships()->orderBy('name')->get() ?? collect(),
                'ward_id' => $address->township?->wards()->orderBy('name')->get() ?? collect(),
            ],
        ]);
    }

    public function update(Request $request, Address $address): RedirectResponse
    {
        $this->ensureOwner($request, $address);
        $data = $this->validatedData($request);

        DB::transaction(function () use ($request, $address, $data): void {
            if ($data['is_default'] ?? false) {
                $request->user()->addresses()->where('id', '!=', $address->getKey())->update(['is_default' => false]);
            }

            $address->update($data);
        });

        return redirect()->route('addresses.index')->with('success', 'Address updated.');
    }

    public function destroy(Request $request, Address $address): RedirectResponse
    {
        $this->ensureOwner($request, $address);
        $address->delete();

        return redirect()->route('addresses.index')->with('success', 'Address deleted.');
    }

    private function validatedData(Request $request): array
    {
        $data = $request->validate([
            'country_id' => ['required', 'exists:countries,id'],
            'state_id' => ['nullable', 'exists:states,id'],
            'district_id' => ['nullable', 'exists:districts,id'],
            'township_id' => ['nullable', 'exists:townships,id'],
            'ward_id' => ['nullable', 'exists:wards,id'],
            'address_line_1' => ['required', 'string', 'max:255'],
            'address_line_2' => ['nullable', 'string', 'max:255'],
            'building_name' => ['nullable', 'string', 'max:255'],
            'unit_number' => ['nullable', 'string', 'max:50'],
            'postal_code' => ['nullable', 'string', 'max:20'],
            'landmark' => ['nullable', 'string', 'max:255'],
            'latitude' => ['nullable', 'numeric', 'between:-90,90'],
            'longitude' => ['nullable', 'numeric', 'between:-180,180'],
            'is_default' => ['sometimes', 'boolean'],
        ]);

        $this->assertHierarchy($data);
        $data['is_default'] = $request->boolean('is_default');

        return $data;
    }

    private function assertHierarchy(array $data): void
    {
        if (! empty($data['state_id']) && State::whereKey($data['state_id'])->value('country_id') != $data['country_id']) {
            throw ValidationException::withMessages(['state_id' => 'The selected state does not belong to this country.']);
        }

        if (! empty($data['district_id']) && District::whereKey($data['district_id'])->value('state_id') != ($data['state_id'] ?? null)) {
            throw ValidationException::withMessages(['district_id' => 'The selected district does not belong to this state.']);
        }

        if (! empty($data['township_id']) && Township::whereKey($data['township_id'])->value('district_id') != ($data['district_id'] ?? null)) {
            throw ValidationException::withMessages(['township_id' => 'The selected township does not belong to this district.']);
        }

        if (! empty($data['ward_id']) && Ward::whereKey($data['ward_id'])->value('township_id') != ($data['township_id'] ?? null)) {
            throw ValidationException::withMessages(['ward_id' => 'The selected ward does not belong to this township.']);
        }
    }

    private function ensureOwner(Request $request, Address $address): void
    {
        abort_unless(
            $address->addressable_type === $request->user()::class
            && (string) $address->addressable_id === (string) $request->user()->getKey(),
            404
        );
    }
}
